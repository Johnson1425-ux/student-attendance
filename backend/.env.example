# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in for local development;
# on Render set the same keys as environment variables.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. On Render use the Internal Database URL and
# set DATABASE_SSL=true.
DATABASE_URL=postgres://attendance:attendance@127.0.0.1:5432/attendance_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Signing key for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed dashboard origins, or * for local development.
# In production set this to the Vercel URL, e.g. https://attendance.vercel.app
CORS_ORIGINS=*

LOG_LEVEL=info

# --- Fingerprint terminal (ADMS) ------------------------------------------
# Require every terminal to have a push secret configured. Leave false during
# initial installation, then turn on once the devices are set up.
DEVICE_PUSH_SECRET_REQUIRED=false

# Create a placeholder (inactive) device record when an unknown serial number
# calls in. Useful while installing hardware: the serial appears in the
# dashboard ready to be named and activated. Keep it off in normal operation.
DEVICE_AUTO_REGISTER=false

# --- Background jobs -------------------------------------------------------
ENABLE_SCHEDULER=true
# Cron expression, evaluated in UTC. The default runs at 23:30 UTC, which is
# 02:30 in Dar es Salaam — comfortably after the school day has ended.
FINALIZE_CRON=30 23 * * *

# --- First-run bootstrap (used only by `npm run seed`) --------------------
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Administrator
